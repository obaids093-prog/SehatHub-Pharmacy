# ============================================================
# SehatHub - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# Flask Secret Key (use a secure random string in production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sehathub_db
DB_PORT=3306

# Application Environment (True for local development, False for production)
FLASK_DEBUG=True

# Session Security (Set to True if serving over HTTPS)
SESSION_COOKIE_SECURE=False

# Groq Cloud API Key for AI Prescription Scanner & Health Assistant
# Get an API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
